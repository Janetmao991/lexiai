# Claude API key — powers every text feature. https://console.anthropic.com/settings/keys
# Optional: you can paste it in Settings instead (stays in that browser).
ANTHROPIC_API_KEY=

# Gemini API key — voice only (transcription + natural voices). https://aistudio.google.com/apikey
API_KEY=

# Supabase project (free tier) — Project Settings -> API Keys
# The publishable key is safe to expose; data is protected by Row Level Security.
SUPABASE_URL=
SUPABASE_KEY=
